APP_NAME=SkillBridge
APP_ENV=development

# Local PostgreSQL. Create database "skillbridge" and enable pgvector first.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/skillbridge

# Local Neo4j Community/Neo4j Desktop Bolt connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

JWT_SECRET_KEY=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
